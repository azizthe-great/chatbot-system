NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Leave DATABASE_URL commented out to use the built-in local database in data/portside-db.
# Set it only to use a PostgreSQL server instead:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/portside
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info
# The administrator account, created the first time the server starts.
# Use a password of at least 12 characters and change it in Account settings after signing in.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Trusted adapters implementing the README JSON contract:
# PORTSIDE_QUOTE_URL=https://your-adapter.example/quote
# PORTSIDE_ADVISOR_URL=https://your-adapter.example/advisor
# PORTSIDE_VIN_URL=https://your-adapter.example/vin
# PORTSIDE_TRACKING_URL=https://your-adapter.example/tracking
# PORTSIDE_PROVIDER_TOKEN=your-private-token

# Google sign-in: create a Web application OAuth client in Google Cloud.
# Set the exact authorized redirect URI below in Google Cloud as well.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
